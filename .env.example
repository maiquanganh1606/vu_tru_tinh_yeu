# Set these in the service environment. This app does not auto-load .env files.
# Persistent local volume; defaults to <project>/instance.
# LOVE_INSTANCE_PATH=/var/lib/love-universe
# Optional persistent secret; if omitted a generated key is stored in SQLite.
# LOVE_SECRET_KEY=generate-a-random-secret-outside-version-control
# Set only when accessed via HTTPS in production.
LOVE_HTTPS=0
# Use 1 only behind exactly one trusted reverse proxy; keep Gunicorn private.
LOVE_TRUSTED_PROXY_HOPS=0

# Configure later. Wishes are stored even before a delivery channel is connected.
WISH_PROVIDER=email
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Alternative: WISH_PROVIDER=email. SMTP uses mandatory STARTTLS.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-login
SMTP_PASSWORD=your-smtp-key
SMTP_FROM=verified-sender@example.com
WISH_EMAIL_TO=recipient@example.com
